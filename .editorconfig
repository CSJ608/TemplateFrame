# EditorConfig：https://editorconfig.org
# 统一仓库内所有编辑器/IDE 的基础风格；.NET 约定参考 dotnet/runtime 的 .editorconfig 精简版。
root = true

[*]
charset = utf-8
insert_final_newline = true
trim_trailing_whitespace = true

[*.{cs,csproj,props,targets}]
indent_style = space
indent_size = 4

[*.{json,yml,yaml,resx,xml,axml}]
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.{sh,cmd,bat}]
end_of_line = lf

# C# 细则（与现有代码习惯一致：file-scoped namespace、var、4 空格）
[*.cs]
csharp_style_namespace_declarations = file_scoped:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion
dotnet_sort_system_directives_first = false
dotnet_style_operator_placement_when_wrapping = beginning_of_line

# 命名（PascalCase 公共成员、_camelCase 私有字段，与现有代码一致）
[*.cs]
dotnet_naming_rule.private_fields_camel_case.severity = suggestion
dotnet_naming_rule.private_fields_camel_case.symbols = private_fields
dotnet_naming_rule.private_fields_camel_case.style = camel_case_underscore
dotnet_naming_symbols.private_fields.applicable_kinds = field
dotnet_naming_symbols.private_fields.applicable_accessibilities = private
dotnet_naming_style.camel_case_underscore.capitalization = camel_case
dotnet_naming_style.camel_case_underscore.required_prefix = _
