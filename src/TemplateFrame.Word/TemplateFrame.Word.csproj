<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>TemplateFrame.Word</RootNamespace>
    <AssemblyName>TemplateFrame.Word</AssemblyName>
    <Description>TemplateFrame 的 MS Word 插件：内容控件（SDT）生成 / 定位 / 填充 / 回读 / 校验</Description>

    <PackageId>TemplateFrame.Word</PackageId>
    <PackageTags>template;word;docx;sdt;office</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.5.1" />
    <!-- Publish the patched minimum to consumers; net462 uses WindowsBase instead. -->
    <PackageReference Include="System.IO.Packaging" Version="10.0.14" Condition="'$(TargetFramework)' != 'net462'" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="TemplateFrame.Word.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TemplateFrame\TemplateFrame.csproj" />
  </ItemGroup>

</Project>
