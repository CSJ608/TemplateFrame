<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>TemplateFrame.Word</RootNamespace>
    <AssemblyName>TemplateFrame.Word</AssemblyName>
    <Description>TemplateFrame 的 MS Word 插件：内容控件（SDT）生成 / 定位 / 填充 / 回读 / 校验</Description>

    <PackageId>TemplateFrame.Word</PackageId>
    <PackageTags>template;word;docx;sdt;office</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.3.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TemplateFrame\TemplateFrame.csproj" />
  </ItemGroup>

</Project>