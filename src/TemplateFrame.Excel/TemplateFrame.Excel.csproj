<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>TemplateFrame.Excel</RootNamespace>
    <AssemblyName>TemplateFrame.Excel</AssemblyName>
    <Description>TemplateFrame 的 MS Excel 插件：命名区域（defined names）定位的生成 / 校验 / 填充 / 回读</Description>

    <!-- 打包准备（迭代 8）：XML doc + NuGet 元数据；版本与 git tag 一致（见 docs/PUBLISHING.md） -->
    <Version>1.0.0</Version>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageId>TemplateFrame.Excel</PackageId>
    <Authors>CSJ608</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/CSJ608/TemplateFrame</RepositoryUrl>
    <PackageTags>template;excel;xlsx;defined-names;office</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.3.0" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="TemplateFrame.Excel.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TemplateFrame\TemplateFrame.csproj" />
  </ItemGroup>

</Project>
