<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>TemplateFrame.Excel</RootNamespace>
    <AssemblyName>TemplateFrame.Excel</AssemblyName>
    <Description>TemplateFrame 的 MS Excel 插件：命名区域（defined names）定位的生成 / 校验 / 填充 / 回读</Description>

    <PackageId>TemplateFrame.Excel</PackageId>
    <PackageTags>template;excel;xlsx;defined-names;office</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.5.1" />
    <!-- Publish the patched minimum to consumers; net462 uses WindowsBase instead. -->
    <PackageReference Include="System.IO.Packaging" Version="10.0.14" Condition="'$(TargetFramework)' != 'net462'" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="TemplateFrame.Excel.Tests" />
    <InternalsVisibleTo Include="TemplateFrame.CapacityProbe" />
    <Compile Include="..\Shared\Excel\*.cs" Link="Shared\Excel\%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TemplateFrame\TemplateFrame.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net462'">
    <Reference Include="System.IO.Compression" />
  </ItemGroup>

</Project>
