<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>TemplateFrame</RootNamespace>
    <AssemblyName>TemplateFrame</AssemblyName>
    <Description>模板 ⇄ 数据契约引擎：契约元素模型 + 数据形状 + Builder 抽象（格式无关基础包）</Description>

    <!-- 打包准备（迭代 5）：XML doc + NuGet 元数据；版本与 git tag 一致（见 docs/PUBLISHING.md） -->
    <Version>1.0.5</Version>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageId>TemplateFrame</PackageId>
    <Authors>CSJ608</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/CSJ608/TemplateFrame</RepositoryUrl>
    <PackageTags>template;contract;data;docx;office</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>