<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>TemplateFrame</RootNamespace>
    <AssemblyName>TemplateFrame</AssemblyName>
    <Description>模板 ⇄ 数据契约引擎：契约元素模型 + 数据形状 + Builder 抽象（格式无关基础包）</Description>

    <PackageId>TemplateFrame</PackageId>
    <PackageTags>template;contract;data;docx;office</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <!-- 迭代 15：Word / Excel 插件共用基础包 internal 工具（StreamUtil / ImageTypeDetector） -->
  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>TemplateFrame.Word</_Parameter1>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>TemplateFrame.Excel</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
