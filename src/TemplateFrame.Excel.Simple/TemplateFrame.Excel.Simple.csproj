<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>TemplateFrame.Excel.Simple</RootNamespace>
    <AssemblyName>TemplateFrame.Excel.Simple</AssemblyName>
    <Description>TemplateFrame 的简化 Excel 插件：支持「标题行 + 数据行」的表格导入/导出，通过命名区域及列定义名定位，不支持合并、图片或页面设置。</Description>

    <PackageId>TemplateFrame.Excel.Simple</PackageId>
    <PackageTags>template;excel;xlsx;simple;table;office</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.5.1" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="TemplateFrame.Excel.Simple.Tests" />
    <Compile Include="..\Shared\Excel\*.cs" Link="Shared\Excel\%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TemplateFrame\TemplateFrame.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net462'">
    <Reference Include="System.IO.Compression" />
  </ItemGroup>
</Project>
